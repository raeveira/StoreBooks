@using StoreBooks.Dto
@using StoreBooks.Models

@if (IsVisible && BookToEdit is not null)
{
    <div class="edit-book-overlay" role="presentation" @onclick="Close">
        <section class="edit-book-overlay__dialog" role="dialog" aria-modal="true" aria-labelledby="edit-book-title"
                 @onclick:stopPropagation="true">
            <div class="edit-book-overlay__header">
                <h2 id="edit-book-title">Edit book</h2>
                <button class="edit-book-overlay__close" type="button" @onclick="Close">Close</button>
            </div>

            <div class="edit-book-overlay__content">
                <EditForm class="edit-book-form" FormName="EditBook" Model="_editedBook" OnValidSubmit="SaveBook">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <p role="alert" class="edit-book-form__error">@_errorMessage</p>
                    }

                    <div class="edit-book-form__grid">
                        <div class="edit-book-form__field">
                            <label for="edit-book-title">Title</label>
                            <InputText id="edit-book-title" @bind-Value="_editedBook.Title" />
                        </div>
                        <div class="edit-book-form__field">
                            <label for="edit-book-author">Author</label>
                            <InputText id="edit-book-author" @bind-Value="_editedBook.Author" />
                        </div>
                        <div class="edit-book-form__field">
                            <label for="edit-book-isbn">ISBN</label>
                            <InputText id="edit-book-isbn" @bind-Value="_editedBook.ISBN" />
                        </div>
                        <div class="edit-book-form__field edit-book-form__field--wide">
                            <label for="edit-book-description">Description</label>
                            <InputTextArea id="edit-book-description" @bind-Value="_editedBook.Description" />
                        </div>
                        <div class="edit-book-form__field">
                            <label for="edit-book-price">Price (cents)</label>
                            <InputNumber id="edit-book-price" @bind-Value="_editedBook.PriceInCents" />
                        </div>
                        <div class="edit-book-form__field">
                            <label for="edit-book-stock">Stock</label>
                            <InputNumber id="edit-book-stock" @bind-Value="_editedBook.Stock" />
                        </div>
                        <div class="edit-book-form__field">
                            <label for="edit-book-published-date">Published date</label>
                            <InputDate id="edit-book-published-date" @bind-Value="_editedBook.PublishedDate" />
                        </div>
                        <div class="edit-book-form__field">
                            <label for="edit-book-genre">Genre</label>
                            <InputText id="edit-book-genre" @bind-Value="_editedBook.Genre" />
                        </div>
                    </div>

                    <div class="edit-book-form__actions">
                        <button class="edit-book-form__submit" type="submit">Save changes</button>
                    </div>
                </EditForm>
            </div>
        </section>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public Book? BookToEdit { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Inject]
    private BookService BookService { get; set; } = default!;

    private BookDto _editedBook = new();
    private string? _errorMessage;
    private Guid? _loadedBookId;
    private bool _wasVisible;

    protected override void OnParametersSet()
    {
        if (IsVisible && BookToEdit is not null && (!_wasVisible || _loadedBookId != BookToEdit.Id))
        {
            _editedBook = new BookDto
            {
                Title = BookToEdit.Title,
                Author = BookToEdit.Author,
                PriceInCents = BookToEdit.PriceInCents,
                Stock = BookToEdit.Stock,
                PublishedDate = BookToEdit.PublishedDate,
                Genre = BookToEdit.Genre,
                Description = BookToEdit.Description,
                ISBN = BookToEdit.ISBN
            };
            _loadedBookId = BookToEdit.Id;
            _errorMessage = null;
        }

        _wasVisible = IsVisible;
    }

    private async Task SaveBook()
    {
        if (BookToEdit is null)
        {
            _errorMessage = "Select a book before saving changes.";
            return;
        }

        try
        {
            bool updated = BookService.UpdateBook(BookToEdit.Id, _editedBook);

            if (!updated)
            {
                _errorMessage = "The book could not be updated. It may have been removed.";
                return;
            }

            _errorMessage = null;
            await OnSaved.InvokeAsync();
            await Close();
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred while updating the book: {ex.Message}";
        }
    }

    private Task Close()
    {
        _errorMessage = null;
        return OnClose.InvokeAsync();
    }
}
